  color = "blue",
  linewidth = 1.1,
  arrow = arrow(length = unit(0.18, "cm"))
  ) +
  
 annotate(
  "text",
  x = 1.5,      # milieu approximatif de la courbe
  y = 1.2,      # au-dessus de la courbe
  label = "phantom(0)[3] * p[x]",
  parse = TRUE,
  color = "blue",
  size = 5) +

  # trait de somme
  geom_segment(
    aes(x = 4, xend = 4, y = -0.8, yend = -1.5),
    linewidth = 1.0,
    color = 'blue'
  ) +
  geom_segment(
    aes(x = 4, xend = 0, y = -1.5, yend = -1.5),
    linewidth = 1.0,
    color = '#243c96',
    arrow = arrow(length = unit(0.18, "cm"))
  ) +
annotate(
  "text",
  x = -0.75,
  y = -1.0,
  label = "Contribution",
  parse = TRUE,
  size = 5
) +
annotate(
  "text",
  x = -0.75,
  y = -1.5,
  label = "1000 * v^4 %*% phantom(0)[3] * p[x] * q[x+3]",
  parse = TRUE,
