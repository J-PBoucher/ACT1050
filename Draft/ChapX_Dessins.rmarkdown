### Suite



```{r}
#| code-fold: true
#| echo: false
#| message: false
#| warning: false
#| fig-height: 4
#| fig-width: 14
#| fig-align: center

library(ggplot2)
library(ggtext)

t_max <- 6

ticks <- data.frame(
  t = 0:t_max,
  y = 0
)

cashflows <- data.frame(
  t = 1,
  y = 0,
  label = c("1")
)

death <- data.frame(
  x = 0.8,
  y = 0
)

p1 <- ggplot() +
  theme_void() +
  coord_cartesian(
  xlim = c(-1.4, t_max + 0.6),
  ylim = c(-2.2, 2.2),
  clip = "off") +

  # ligne du temps
  geom_segment(
    aes(x = 0, xend = t_max, y = 0, yend = 0),
    linewidth = 1.4,
    color = "#4a4a4a"
  ) +

  # graduations
  geom_segment(
    data = ticks,
    aes(x = t, xend = t, y = -0.10, yend = 0.10),
    linewidth = 1.2,
    color = "#4a4a4a"
  ) +

  # labels temps
  
  annotate(
  "text",
  x = -0.75,
  y =  0.35,
  label = "Temps (t)",
  parse = TRUE,
  size = 5
  ) +
  
  geom_text(
    data = ticks,
    aes(x = t, y = 0.35, label = t),
    size = 5,
    color = "#4a4a4a"
  ) +

  # labels des flux
  geom_text(
    data = cashflows,
    aes(x = t, y = -0.5, label = label),
    size = 5,
    color = "red"
  ) +

  # décès (croix rouge)
  geom_point(
    data = death,
    aes(x = x, y = y),
    shape = 4,
    size = 3,
    stroke = 1.5,
    color = "red"
  ) +
  
 geom_curve(
  aes(x = 0.05, y = 0.6, xend = 0.8, yend = 0.6),
  curvature = -0.25,
  color = "red",
  linewidth = 1.1,
  arrow = arrow(length = unit(0.18, "cm"))
  ) +
  
 annotate(
  "text",
  x = 0.4,      # milieu approximatif de la courbe
  y = 1.2,      # au-dessus de la courbe
  label = "q[x]",
  parse = TRUE,
  color = "red",
  size = 5) +

  # trait de somme
  geom_segment(
    aes(x = 1, xend = 1, y = -0.7, yend = -0.9),
    linewidth = 1.0,
    color = '#243c96'
  ) +
  geom_segment(
    aes(x = 1, xend = 0, y = -0.9, yend = -0.9),
    linewidth = 1.0,
    color = '#243c96',
    arrow = arrow(length = unit(0.18, "cm"))
  ) +
annotate(
  "text",
  x = -0.75,
  y = -0.9,
  label = "1 %*% q[x]",
  parse = TRUE,
  size = 5
)

cashflows <- data.frame(
  t = 2,
  y = 0,
  label = c("2")
)

death <- data.frame(
  x = 1.8,
  y = 0
)

p2 <- ggplot() +
  theme_void() +
  coord_cartesian(
  xlim = c(-1.4, t_max + 0.6),
  ylim = c(-2.2, 2.2),
  clip = "off") +

  # ligne du temps
  geom_segment(
    aes(x = 0, xend = t_max, y = 0, yend = 0),
    linewidth = 1.4,
    color = "#4a4a4a"
  ) +

  # graduations
  geom_segment(
    data = ticks,
    aes(x = t, xend = t, y = -0.10, yend = 0.10),
    linewidth = 1.2,
    color = "#4a4a4a"
  ) +

  # labels temps
  
  annotate(
  "text",
  x = -0.75,
  y =  0.35,
  label = "Temps (t)",
  parse = TRUE,
  size = 5
  ) +
  
  geom_text(
    data = ticks,
    aes(x = t, y = 0.35, label = t),
    size = 5,
    color = "#4a4a4a"
  ) +

  # labels des flux
  geom_text(
    data = cashflows,
    aes(x = t, y = -0.5, label = label),
    size = 5,
    color = "red"
  ) +

  # décès (croix rouge)
  geom_point(
    data = death,
    aes(x = x, y = y),
    shape = 4,
    size = 3,
    stroke = 1.5,
    color = "red"
  ) +
  
 geom_curve(
  aes(x = 1.05, y = 0.6, xend = 1.8, yend = 0.6),
  curvature = -0.25,
  color = "red",
  linewidth = 1.1,
  arrow = arrow(length = unit(0.18, "cm"))
  ) +
  
 annotate(
  "text",
  x = 1.4,      # milieu approximatif de la courbe
  y = 1.2,      # au-dessus de la courbe
  label = "q[x+1]",
  parse = TRUE,
  color = "red",
  size = 5) +
  
 geom_curve(
  aes(x = 0, y = 0.6, xend = 0.95, yend = 0.6),
  curvature = -0.1,
  color = "blue",
  linewidth = 1.1,
  arrow = arrow(length = unit(0.18, "cm"))
  ) +
  
 annotate(
  "text",
  x = 0.5,      # milieu approximatif de la courbe
  y = 1.2,      # au-dessus de la courbe
  label = "phantom(0)[1] * p[x]",
  parse = TRUE,
  color = "blue",
  size = 5) +

  # trait de somme
  geom_segment(
    aes(x = 2, xend = 2, y = -0.8, yend = -1.2),
    linewidth = 1.0,
    color = '#243c96'
  ) +
  geom_segment(
    aes(x = 2, xend = 0, y = -1.2, yend = -1.2),
    linewidth = 1.0,
    color = '#243c96',
    arrow = arrow(length = unit(0.18, "cm"))
  ) +
annotate(
  "text",
  x = -0.75,
  y = -0.9,
  label = "1 %*% q[x]",
  parse = TRUE,
  size = 5
) +
annotate(
  "text",
  x = -0.75,
  y = -1.2,
  label = "2 %*% phantom(0)[1] * p[x] * q[x+1]",
  parse = TRUE,
  size = 5
)


