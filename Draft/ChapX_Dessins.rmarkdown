# Dessins

## Probabilités cumlatives



```{r}
#| code-fold: true
#| echo: false
#| message: false
#| warning: false
#| fig-height: 4
#| fig-width: 14
#| fig-align: center

library(ggplot2)
library(ggtext)
library(grid)
library(magick)

plot_survie_k <- function(k, t_max = 6) {
  
  if (!k %in% 1:6) {
    stop("k doit être un entier entre 1 et 6.")
  }
  
  ticks <- data.frame(
    t = 0:t_max,
    y = 0
  )
  
  green_arrows <- data.frame(
    x    = 0:(k - 1) + 0.05,
    xend = 0:(k - 1) + 0.95,
    y    = 0.6,
    yend = 0.6
  )
  
  green_labels <- data.frame(
    x = 0:(k - 1) + 0.5,
    y = 1.2,
    label = sapply(0:(k - 1), function(j) {
      if (j == 0) "p[x]" else paste0("p[x+", j, "]")
    })
  )
  
  blue_label <- paste0("phantom(0)[", k, "] * p[x]")
  
  ggplot() +
    theme_void() +
    coord_cartesian(
      xlim = c(-1.4, t_max + 0.6),
      ylim = c(-3.2, 3.2),
      clip = "off"
    ) +
    geom_segment(
      aes(x = 0, xend = t_max, y = 0, yend = 0),
      linewidth = 1.4,
      color = "#4a4a4a"
    ) +
    geom_segment(
      data = ticks,
      aes(x = t, xend = t, y = -0.10, yend = 0.10),
      linewidth = 1.2,
      color = "#4a4a4a"
    ) +
    annotate(
      "text",
      x = -0.75,
      y = 0.35,
      label = "Temps~(t)",
      parse = TRUE,
      size = 5
    ) +
    geom_text(
      data = ticks,
      aes(x = t, y = 0.35, label = t),
      size = 5,
      color = "#4a4a4a"
    ) +
    geom_curve(
      data = green_arrows,
      aes(x = x, y = y, xend = xend, yend = yend),
      curvature = -0.25,
      color = "#00BA38",
      linewidth = 1.1,
      arrow = arrow(length = unit(0.18, "cm"))
    ) +
    geom_text(
      data = green_labels,
      aes(x = x, y = y, label = label),
      parse = TRUE,
      color = "#00BA38",
      size = 5
    ) +
    geom_curve(
      aes(x = 0.05, y = -0.26, xend = k - 0.05, yend = -0.26),
      curvature = 0.1,
      color = "blue",
      linewidth = 1.1,
      arrow = arrow(length = unit(0.18, "cm"))
    ) +
    annotate(
      "text",
      x = k / 2,
      y = -0.85,
      label = blue_label,
      parse = TRUE,
      color = "blue",
      size = 5
    )
}

gif_file <- "survie.gif"

if (!file.exists(gif_file)) {
  
  plots <- lapply(1:6, plot_survie_k)
  tmp_files <- paste0("frame_", 1:6, ".png")
  
  for (i in 1:6) {
    ggsave(
      filename = tmp_files[i],
      plot = plots[[i]],
      width = 10,
      height = 5,
      units = "in",
      dpi = 600
    )
  }
  
  gif <- image_read(tmp_files) |>
    image_animate(fps = 1)
  
  image_write(gif, path = gif_file)
  
  file.remove(tmp_files)
}

```



![](survie.gif){width=70%}

## Espérance de vie




```{r}
#| code-fold: true
#| echo: false
#| message: false
#| warning: false
#| fig-height: 4
#| fig-width: 14
#| fig-align: center

library(ggplot2)
library(ggtext)
library(grid)

plot_deces_k <- function(k, t_max = 6) {
  
  if (!k %in% 1:6) {
    stop("k doit être un entier entre 1 et 6.")
  }
  
  ticks <- data.frame(
    t = 0:t_max,
    y = 0
  )
  
  cashflows <- data.frame(
    t = k,
    y = 0,
    label = as.character(k)
  )
  
  death <- data.frame(
    x = k - 0.2,
    y = 0
  )
  
  # positions verticales des termes de somme
  y_terms <- seq(-0.9, by = -0.3, length.out = k)
  
  # étiquettes en bas
  bottom_labels <- sapply(1:k, function(j) {
    if (j == 1) {
      "1 %*% q[x]"
    } else {
      paste0(
        j,
        " %*% phantom(0)[", j - 1, "] * p[x] * q[x+", j - 1, "]"
      )
    }
  })
  
  p <- ggplot() +
    theme_void() +
    coord_cartesian(
      xlim = c(-1.4, t_max + 0.6),
      ylim = c(-3.4, 2.2),
      clip = "off"
    ) +
    
    # ligne du temps
    geom_segment(
      aes(x = 0, xend = t_max+0.6, y = 0, yend = 0),
      linewidth = 1.4,
      color = "#4a4a4a"
    ) +
    
    # graduations
    geom_segment(
      data = ticks,
      aes(x = t, xend = t, y = -0.10, yend = 0.10),
      linewidth = 1.2,
      color = "#4a4a4a"
    ) +
    
    # label du temps
    annotate(
      "text",
      x = -0.75,
      y = 0.35,
      label = "Temps~(t)",
      parse = TRUE,
      size = 5
    ) +
    
    # chiffres de temps
    geom_text(
      data = ticks,
      aes(x = t, y = 0.35, label = t),
      size = 5,
      color = "#4a4a4a"
    ) +
    
    # flux
    geom_text(
      data = cashflows,
      aes(x = t, y = -0.5, label = label),
      size = 5,
      color = "red"
    ) +
    
    # décès
    geom_point(
      data = death,
      aes(x = x, y = y),
      shape = 4,
      size = 3,
      stroke = 1.5,
      color = "red"
    ) +
    
    # flèche rouge
    geom_curve(
      aes(
        x = (k - 1) + 0.05,
        y = 0.6,
        xend = k - 0.2,
        yend = 0.6
      ),
      curvature = -0.25,
      color = "red",
      linewidth = 1.1,
      arrow = arrow(length = unit(0.18, "cm"))
    ) +
    
    # label rouge
    annotate(
      "text",
      x = k - 0.6,
      y = 1.2,
      label = if (k == 1) "q[x]" else paste0("q[x+", k - 1, "]"),
      parse = TRUE,
      color = "red",
      size = 5
    ) +
    
    # trait vertical de somme
    geom_segment(
      aes(
        x = k,
        xend = k,
        y = -0.8,
        yend = y_terms[k]
      ),
      linewidth = 1.0,
      color = "#243c96"
    ) +
    
    # trait horizontal de somme
    geom_segment(
      aes(
        x = k,
        xend = 0,
        y = y_terms[k],
        yend = y_terms[k]
      ),
      linewidth = 1.0,
      color = "#243c96",
      arrow = arrow(length = unit(0.18, "cm"))
    )
  
  # flèche bleue et label bleu si k >= 2
  if (k >= 2) {
    p <- p +
      geom_curve(
        aes(
          x = 0,
          y = 0.6,
          xend = k - 1 + 0.95 - 1,
          yend = 0.6
        ),
        curvature = -0.1,
        color = "blue",
        linewidth = 1.1,
        arrow = arrow(length = unit(0.18, "cm"))
      ) +
      annotate(
        "text",
        x = (k - 1) / 2,
        y = 1.2,
        label = paste0("phantom(0)[", k - 1, "] * p[x]"),
        parse = TRUE,
        color = "blue",
        size = 5
      )
  }
  
  # étiquettes du bas
  for (j in 1:k) {
    p <- p +
      annotate(
        "text",
        x = -0.75,
        y = y_terms[j],
        label = bottom_labels[j],
        color = "#243c96",
        parse = TRUE,
        size = 5
      )
  }
  
  p
}

gif_file <- "esperance.gif"

if (!file.exists(gif_file)) {
  
  plots <- lapply(1:6, plot_deces_k)
  
  plots[[7]] <- plots[[6]] +
    annotate(
      "text",
      x = -0.75,
      y = -2.7,
      label = "...",
      color = "#243c96",
      parse = TRUE,
      size = 5
    ) +
    annotate(
      "text",
      x = -0.75,
      y = -2.8,
      label = "_________",
      color = "#243c96",
      size = 5
    ) +
    annotate(
      "text",
      x = -0.75,
      y = -3.2,
      label = "sum((t+1) * phantom(0)[t] * p[x] * q[x+t], t==0, infinity)",
      parse = TRUE,
      color = "#243c96",
      size = 5
    )
  
  plots[[8]] <- plots[[7]]
  plots[[9]] <- plots[[7]]
  plots[[10]] <- plots[[7]]
  
  tmp_files <- paste0("frame_", 1:10, ".png")
  
  for (i in 1:10) {
    ggsave(
      filename = tmp_files[i],
      plot = plots[[i]],
      width = 10,
      height = 5,
      units = "in",
      dpi = 600
    )
  }
  
  gif <- image_read(tmp_files) |>
    image_animate(fps = 1)
  
  image_write(gif, path = gif_file)
  
  file.remove(tmp_files)
}


```



![](esperance.gif){width=70%}

