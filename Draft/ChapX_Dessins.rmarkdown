# ------------------------------------------------------------
# Exemple : décès à t = 1
# (change x si tu veux le placer ailleurs)
# ------------------------------------------------------------
death_display <- data.frame(
  x = 5.8,
  y = 0
)

cashflows <- data.frame(
  t = 6,
  y = 0,
  label = c("T")
)

# ------------------------------------------------------------
# Graphique
# ------------------------------------------------------------

pT <- ggplot() +
  theme_void() +
  coord_cartesian(
    xlim = c(-1.4, 6.8),
    ylim = c(-2.2, 2.2),
    clip = "off"
  ) +

  # ----------------------------------------------------------
  # Ligne du temps : segment gauche
  # ----------------------------------------------------------
  geom_segment(
    aes(x = x0, xend = x3 + 0.25, y = 0, yend = 0),
    linewidth = 1.4,
    color = "#4a4a4a"
  ) +

  # ----------------------------------------------------------
  # Ligne du temps : segment droit
  # ----------------------------------------------------------
  geom_segment(
    aes(x = xTm1 - 0.25, xend = xT, y = 0, yend = 0),
    linewidth = 1.4,
    color = "#4a4a4a"
  ) +

  # ----------------------------------------------------------
  # Graduations
  # ----------------------------------------------------------
  geom_segment(
    data = ticks_display,
    aes(x = x, xend = x, y = -0.10, yend = 0.10),
    linewidth = 1.2,
    color = "#4a4a4a"
  ) +

  # ----------------------------------------------------------
  # Label "Temps (t)"
  # ----------------------------------------------------------
  annotate(
    "text",
    x = -0.95,
    y = 0.35,
    label = "Temps~(t)",
    parse = TRUE,
    size = 5
  ) +

  # ----------------------------------------------------------
  # Étiquettes des temps
  # ----------------------------------------------------------
  geom_text(
    data = ticks_display,
    aes(x = x, y = 0.35, label = lab),
    parse = TRUE,
    size = 5,
    color = "#4a4a4a"
  ) +

  # ----------------------------------------------------------
  # Points de suspension entre 3 et T-1
  # ----------------------------------------------------------
  annotate(
    "text",
    x = xEll,
    y = 0.35,
    label = "...",
    size = 6,
    color = "#4a4a4a"
  ) +

  # ----------------------------------------------------------
  # Décès (croix rouge)
  # ----------------------------------------------------------
  geom_point(
    data = death_display,
    aes(x = x, y = y),
    shape = 4,
    size = 3,
    stroke = 1.5,
    color = "red"
  ) +
    # labels des flux
  geom_text(
    data = cashflows,
    aes(x = t, y = -0.5, label = label),
    size = 5,
    color = "red"
  ) +

  # ----------------------------------------------------------
  # Flèche courbe associée à q_x
  # ----------------------------------------------------------
  geom_curve(
    aes(x = 5.05, y = 0.6, xend = 5.8, yend = 0.6),
    curvature = -0.25,
    color = "red",
    linewidth = 1.1,
    arrow = arrow(length = unit(0.18, "cm"))
  ) +

  annotate(
    "text",
    x = 5.4,
    y = 1.2,
    label = "q[x+T-1]",
    parse = TRUE,
    color = "red",
    size = 5
  ) +
  geom_curve(
  aes(x = 0, y = 0.6, xend = 4.95, yend = 0.6),
  curvature = -0.1,
  color = "blue",
  linewidth = 1.1,
  arrow = arrow(length = unit(0.18, "cm"))
  ) +
  annotate(
  "text",
  x = 2.5,      # milieu approximatif de la courbe
  y = 1.2,      # au-dessus de la courbe
  label = "phantom(0)[T-1] * p[x]",
  parse = TRUE,
  color = "blue",
  size = 5) +

  # ----------------------------------------------------------
  # Petit schéma de somme en bas
  # ----------------------------------------------------------
  geom_segment(
    aes(x = 6, xend = 6, y = -0.7, yend = -2.1),
    linewidth = 1.0,
    color = "#243c96"
  ) +
  geom_segment(
    aes(x = 6, xend = 0, y = -2.1, yend = -2.1),
    linewidth = 1.0,
    color = "#243c96",
    arrow = arrow(length = unit(0.18, "cm"))
  ) +

  annotate(
    "text",
    x = -0.75,
    y = -0.9,
    label = "1 %*% q[x]",
    parse = TRUE,
    size = 5
  ) +
  annotate(
  "text",
  x = -0.75,
  y = -1.2,
  label = "2 %*% phantom(0)[1] * p[x] * q[x+1]",
  parse = TRUE,
  size = 5
)+
  annotate(
  "text",
  x = -0.75,
  y = -1.5,
  label = "3 %*% phantom(0)[2] * p[x] * q[x+2]",
  parse = TRUE,
  size = 5
)+
  annotate(
  "text",
  x = -0.75,
  y = -1.8,
  label = "...",
  parse = TRUE,
  size = 5
)+
annotate(
  "text",
  x = -0.75,
  y = -2.1,
  label = "T %*% phantom(0)[T-1] * p[x] * q[T]",
  parse = TRUE,
  color="red",
  size = 5
)




