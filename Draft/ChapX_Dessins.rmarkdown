## Ligne brisée

![](esp.gif){width=100%}




```{r}
#| code-fold: true
#| echo: false
#| message: false
#| warning: false
#| fig-height: 4
#| fig-width: 14
#| fig-align: center

library(ggplot2)
library(grid)

# ------------------------------------------------------------
# Positions graphiques sur la ligne du temps
# ------------------------------------------------------------
x0   <- 0
x1   <- 1
x2   <- 2
x3   <- 3
xEll <- 4   # position des ...
xTm1 <- 5
xT   <- 6

# ------------------------------------------------------------
# Graduations affichées
# ------------------------------------------------------------
ticks_display <- data.frame(
  x = c(x0, x1, x2, x3, xTm1, xT),
  lab = c("0", "1", "2", "3", "T-1", "T")
)

# ------------------------------------------------------------
# Exemple : décès à t = 1
# (change x si tu veux le placer ailleurs)
# ------------------------------------------------------------
death_display <- data.frame(
  x = 0.8,
  y = 0
)

cashflows <- data.frame(
  t = 1,
  y = 0,
  label = c("1")
)

# ------------------------------------------------------------
# Graphique
# ------------------------------------------------------------
p1 <- ggplot() +
  theme_void() +
  coord_cartesian(
    xlim = c(-1.4, 6.8),
    ylim = c(-2.2, 2.2),
    clip = "off"
  ) +

  # ----------------------------------------------------------
  # Ligne du temps : segment gauche
  # ----------------------------------------------------------
  geom_segment(
    aes(x = x0, xend = x3 + 0.25, y = 0, yend = 0),
    linewidth = 1.4,
    color = "#4a4a4a"
  ) +

  # ----------------------------------------------------------
  # Ligne du temps : segment droit
  # ----------------------------------------------------------
  geom_segment(
    aes(x = xTm1 - 0.25, xend = xT, y = 0, yend = 0),
    linewidth = 1.4,
    color = "#4a4a4a"
  ) +

  # ----------------------------------------------------------
  # Graduations
  # ----------------------------------------------------------
  geom_segment(
    data = ticks_display,
    aes(x = x, xend = x, y = -0.10, yend = 0.10),
    linewidth = 1.2,
    color = "#4a4a4a"
  ) +

  # ----------------------------------------------------------
  # Label "Temps (t)"
  # ----------------------------------------------------------
  annotate(
    "text",
    x = -0.95,
    y = 0.35,
    label = "Temps~(t)",
    parse = TRUE,
    size = 5
  ) +

  # ----------------------------------------------------------
  # Étiquettes des temps
  # ----------------------------------------------------------
  geom_text(
    data = ticks_display,
    aes(x = x, y = 0.35, label = lab),
    parse = TRUE,
    size = 5,
    color = "#4a4a4a"
  ) +

  # ----------------------------------------------------------
  # Points de suspension entre 3 et T-1
  # ----------------------------------------------------------
  annotate(
    "text",
    x = xEll,
    y = 0.35,
    label = "...",
    size = 6,
    color = "#4a4a4a"
  ) +

  # ----------------------------------------------------------
  # Décès (croix rouge)
  # ----------------------------------------------------------
  geom_point(
    data = death_display,
    aes(x = x, y = y),
    shape = 4,
    size = 3,
    stroke = 1.5,
    color = "red"
  ) +
    # labels des flux
  geom_text(
    data = cashflows,
    aes(x = t, y = -0.5, label = label),
    size = 5,
    color = "red"
  ) +

  # ----------------------------------------------------------
  # Flèche courbe associée à q_x
  # ----------------------------------------------------------
  geom_curve(
    aes(x = 0.05, y = 0.6, xend = 0.8, yend = 0.6),
    curvature = -0.25,
    color = "red",
    linewidth = 1.1,
    arrow = arrow(length = unit(0.18, "cm"))
  ) +

  annotate(
    "text",
    x = 0.4,
    y = 1.2,
    label = "q[x]",
    parse = TRUE,
    color = "red",
    size = 5
  ) +

  # ----------------------------------------------------------
  # Petit schéma de somme en bas
  # ----------------------------------------------------------
  geom_segment(
    aes(x = 1, xend = 1, y = -0.7, yend = -0.9),
    linewidth = 1.0,
    color = "#243c96"
  ) +
  geom_segment(
    aes(x = 1, xend = 0, y = -0.9, yend = -0.9),
    linewidth = 1.0,
    color = "#243c96",
    arrow = arrow(length = unit(0.18, "cm"))
  ) +

  annotate(
    "text",
    x = -0.75,
    y = -0.9,
    label = "1 %*% q[x]",
    parse = TRUE,
    color = "red",
    size = 5
  )

p1


