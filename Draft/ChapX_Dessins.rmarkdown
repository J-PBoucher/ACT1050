### GIF



```{r}
#| code-fold: true
#| echo: false
#| message: false
#| warning: false
#| fig-height: 4
#| fig-width: 14
#| fig-align: center

library(ggplot2)
library(grid)
library(magick)

COL_AXIS <- "#4a4a4a"
COL_RED  <- "red"
COL_BLUE <- "blue"
COL_SUM  <- "#243c96"

x0   <- 0
x1   <- 1
x2   <- 2
x3   <- 3
xEll <- 4
xTm1 <- 5
xT   <- 6

ticks_display <- data.frame(
  x   = c(x0, x1, x2, x3, xTm1, xT),
  lab = c("0", "1", "2", "3", "T-1", "T")
)

base_timeline <- function(ylim = c(-2.2, 2.2)) {
  ggplot() +
    theme_void() +
    coord_cartesian(
      xlim = c(-1.4, 6.8),
      ylim = ylim,
      clip = "off"
    ) +
    geom_segment(
      aes(x = x0, xend = x3 + 0.25, y = 0, yend = 0),
      linewidth = 1.4,
      color = COL_AXIS
    ) +
    geom_segment(
      aes(x = xTm1 - 0.25, xend = xT, y = 0, yend = 0),
      linewidth = 1.4,
      color = COL_AXIS
    ) +
    geom_segment(
      data = ticks_display,
      aes(x = x, xend = x, y = -0.10, yend = 0.10),
      linewidth = 1.2,
      color = COL_AXIS
    ) +
    annotate(
      "text",
      x = -0.95,
      y = 0.35,
      label = "Temps~(t)",
      parse = TRUE,
      size = 5
    ) +
    geom_text(
      data = ticks_display,
      aes(x = x, y = 0.35, label = lab),
      parse = TRUE,
      size = 5,
      color = COL_AXIS
    ) +
    annotate(
      "text",
      x = xEll,
      y = 0.35,
      label = "...",
      size = 6,
      color = COL_AXIS
    )
}

add_bottom_terms <- function(p, terms, x_text = -0.75, y_start = -0.9, y_step = -0.3) {
  ys <- y_start + (seq_along(terms) - 1) * y_step

  for (i in seq_along(terms)) {
    p <- p + annotate(
      "text",
      x = x_text,
      y = ys[i],
      label = terms[[i]]$label,
      parse = TRUE,
      color = terms[[i]]$color,
      size = 5
    )
  }

  p
}

add_sum_bracket <- function(p, x_top, y_top = -0.7, y_bottom) {
  p +
    geom_segment(
      aes(x = x_top, xend = x_top, y = y_top, yend = y_bottom),
      linewidth = 1.0,
      color = COL_SUM
    ) +
    geom_segment(
      aes(x = x_top, xend = 0, y = y_bottom, yend = y_bottom),
      linewidth = 1.0,
      color = COL_SUM,
      arrow = arrow(length = unit(0.18, "cm"))
    )
}

plot_survie_k <- function(k) {

  if (k == "p0a") {
    terms <- list(
      list(label = "1 %*% q[x]", color = "black"),
      list(label = "2 %*% phantom(0)[1] * p[x] * q[x+1]", color = "black"),
      list(label = "3 %*% phantom(0)[2] * p[x] * q[x+2]", color = "black"),
      list(label = "...", color = COL_RED)
    )

    p <- base_timeline()
    p <- add_sum_bracket(p, x_top = 4, y_bottom = -1.8)
    p <- add_bottom_terms(p, terms = terms)
    return(p)
  }

  if (k == "p0b") {
    terms <- list(
      list(label = "1 %*% q[x]", color = "black"),
      list(label = "2 %*% phantom(0)[1] * p[x] * q[x+1]", color = "black"),
      list(label = "3 %*% phantom(0)[2] * p[x] * q[x+2]", color = "black"),
      list(label = "...", color = "black"),
      list(label = "T %*% phantom(0)[T-1] * p[x] * q[x+T-1]", color = "black")
    )

    p <- base_timeline(ylim = c(-3.2, 2.2))
    p <- add_bottom_terms(p, terms = terms)
    p <- p +
      annotate(
        "text",
        x = -0.75,
        y = -2.2,
        label = "_________",
        size = 5
      ) +
      annotate(
        "text",
        x = -0.75,
        y = -2.7,
        label = "sum((t+1) %*% phantom(0)[t] * p[x] * q[x+t], t==0, T-1)",
        parse = TRUE,
        color = COL_RED,
        size = 5
      )
    return(p)
  }

  params <- list(
    p1 = list(
      death_x       = 0.8,
      cash_x        = 1,
      cash_label    = "1",
      q_curve_x     = c(0.05, 0.8),
      q_text_x      = 0.4,
      q_text_lab    = "q[x]",
      surv_curve    = NULL,
      surv_text_x   = NULL,
      surv_text_lab = NULL,
      bracket_x     = 1,
      bracket_y     = -0.9,
      terms = list(
        list(label = "1 %*% q[x]", color = COL_RED)
      )
    ),

    p2 = list(
      death_x       = 1.8,
      cash_x        = 2,
      cash_label    = "2",
      q_curve_x     = c(1.05, 1.8),
      q_text_x      = 1.4,
      q_text_lab    = "q[x]",
      surv_curve    = c(0, 0.95),
      surv_text_x   = 0.5,
      surv_text_lab = "phantom(0)[1] * p[x]",
      bracket_x     = 2,
      bracket_y     = -1.2,
      terms = list(
        list(label = "1 %*% q[x]", color = "black"),
        list(label = "2 %*% phantom(0)[1] * p[x] * q[x+1]", color = COL_RED)
      )
    ),

    p3 = list(
      death_x       = 2.8,
      cash_x        = 3,
      cash_label    = "3",
      q_curve_x     = c(2.05, 2.8),
      q_text_x      = 2.4,
      q_text_lab    = "q[x]",
      surv_curve    = c(0, 1.95),
      surv_text_x   = 1.5,
      surv_text_lab = "phantom(0)[2] * p[x]",
      bracket_x     = 3,
      bracket_y     = -1.5,
      terms = list(
        list(label = "1 %*% q[x]", color = "black"),
        list(label = "2 %*% phantom(0)[1] * p[x] * q[x+1]", color = "black"),
        list(label = "3 %*% phantom(0)[2] * p[x] * q[x+2]", color = COL_RED)
      )
    ),

    pT = list(
      death_x       = 5.8,
      cash_x        = 6,
      cash_label    = "T",
      q_curve_x     = c(5.05, 5.8),
      q_text_x      = 5.4,
      q_text_lab    = "q[x+T-1]",
      surv_curve    = c(0, 4.95),
      surv_text_x   = 2.5,
      surv_text_lab = "phantom(0)[T-1] * p[x]",
      bracket_x     = 6,
      bracket_y     = -2.1,
      terms = list(
        list(label = "1 %*% q[x]", color = "black"),
        list(label = "2 %*% phantom(0)[1] * p[x] * q[x+1]", color = "black"),
        list(label = "3 %*% phantom(0)[2] * p[x] * q[x+2]", color = "black"),
        list(label = "...", color = "black"),
        list(label = "T %*% phantom(0)[T-1] * p[x] * q[x+T-1]", color = COL_RED)
      )
    )
  )

  prm <- params[[k]]

  death_display <- data.frame(x = prm$death_x, y = 0)
  cashflows     <- data.frame(t = prm$cash_x, y = 0, label = prm$cash_label)

  p <- base_timeline() +
    geom_point(
      data = death_display,
      aes(x = x, y = y),
      shape = 4,
      size = 3,
      stroke = 1.5,
      color = COL_RED
    ) +
    geom_text(
      data = cashflows,
      aes(x = t, y = -0.5, label = label),
      size = 5,
      color = COL_RED
    ) +
    geom_curve(
      aes(
        x = prm$q_curve_x[1], y = 0.6,
        xend = prm$q_curve_x[2], yend = 0.6
      ),
      curvature = -0.25,
      color = COL_RED,
      linewidth = 1.1,
      arrow = arrow(length = unit(0.18, "cm"))
    ) +
    annotate(
      "text",
      x = prm$q_text_x,
      y = 1.2,
      label = prm$q_text_lab,
      parse = TRUE,
      color = COL_RED,
      size = 5
    )

  if (!is.null(prm$surv_curve)) {
    p <- p +
      geom_curve(
        aes(
          x = prm$surv_curve[1], y = 0.6,
          xend = prm$surv_curve[2], yend = 0.6
        ),
        curvature = -0.1,
        color = COL_BLUE,
        linewidth = 1.1,
        arrow = arrow(length = unit(0.18, "cm"))
      ) +
      annotate(
        "text",
        x = prm$surv_text_x,
        y = 1.2,
        label = prm$surv_text_lab,
        parse = TRUE,
        color = COL_BLUE,
        size = 5
      )
  }

  p <- add_sum_bracket(p, x_top = prm$bracket_x, y_bottom = prm$bracket_y)
  p <- add_bottom_terms(p, terms = prm$terms)

  p
}

p1  <- plot_survie_k("p1")
p2  <- plot_survie_k("p2")
p3  <- plot_survie_k("p3")
p0a <- plot_survie_k("p0a")
pT  <- plot_survie_k("pT")
p0b <- plot_survie_k("p0b")

gif_file <- "esp.gif"

plot_order <- c("p1", "p2", "p3", "p0a", "pT", "p0b")

if (!file.exists(gif_file)) {
  plots <- lapply(plot_order, plot_survie_k)
  tmp_files <- paste0("frame_", seq_along(plots), ".png")

  for (i in seq_along(plots)) {
    ggsave(
      filename = tmp_files[i],
      plot = plots[[i]],
      width = 10,
      height = 5,
      units = "in",
      dpi = 600
    )
  }

  gif <- image_read(tmp_files) |>
    image_animate(fps = 1)

  image_write(gif, path = gif_file)
  file.remove(tmp_files)
}


