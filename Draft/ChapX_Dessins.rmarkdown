## Autre



```{r}
#| code-fold: true
#| echo: false
#| message: false
#| warning: false
#| fig-height: 4
#| fig-width: 14
#| fig-align: center

library(ggplot2)

# ----------------------------
# Paramètres
# ----------------------------
i <- 0.05
payment <- 1000
times <- 0:4
pv <- payment / (1 + i)^times

blue   <- "#243c96"
dark   <- "#3f4150"
orange <- "#f05a28"
bg     <- "#f5f2ea"

# ----------------------------
# Données
# ----------------------------

# graduations de la ligne du temps
ticks <- data.frame(
  t = 0:5,
  y = 0
)

# paiements de la rente due : t = 0,1,2,3,4
cf <- data.frame(
  t = 0:4,
  y_top = -0.75
)

# positions des expressions à gauche
eq <- data.frame(
  t = 0:4,
  x_left = -2.05,
  x_val  = -0.30,
  x_arrow = -0.42,
  y = c(-1.10, -2.15, -3.20, -4.25, -5.30),
  pv_label = sprintf("$%.2f", round(pv, 2))
)

# segments verticaux puis horizontaux
segs_v <- data.frame(
  x = times,
  xend = times,
  y = -0.95,
  yend = eq$y
)

segs_h <- data.frame(
  x = times,
  xend = eq$x_arrow,
  y = eq$y,
  yend = eq$y
)

# labels de fraction en plotmath
frac_labels <- c(
  "frac(1000, (1.05)^0)",
  "frac(1000, (1.05)^1)",
  "frac(1000, (1.05)^2)",
  "frac(1000, (1.05)^3)",
  "frac(1000, (1.05)^4)"
)

eq$frac_label <- frac_labels

sum_pv <- sprintf("$%.2f", round(sum(pv), 2))

# ----------------------------
# Graphique
# ----------------------------

ggplot() +
  coord_cartesian(
    xlim = c(-2.8, 5.8),
    ylim = c(-7.2, 1.2),
    clip = "off"
  ) +

  # fond
  theme_void() +

  # ligne du temps
  geom_segment(
    aes(x = 0, xend = 5, y = 0, yend = 0),
    linewidth = 1.6,
    color = dark
  ) +
  
 annotate(
  "text",
  x = -0.5,
  y = 1.1,
  label = "t",
  parse = TRUE,
  size = 5
  ) +

  annotate(
  "text",
  x = -0.5,
  y = 0.58,
  label = "x",
  parse = TRUE,
  size = 3.5
  ) +
  
  # graduations
  geom_segment(
    data = ticks,
    aes(x = t, xend = t, y = -0.28, yend = 0.28),
    linewidth = 2.0,
    color = dark
  ) +

  # labels 0,1,2,3,4,5 au-dessus
  geom_text(
    data = ticks,
    aes(x = t, y = 1.1, label = t),
    size = 5,
    color = dark
  ) +

  # labels Age au-dessus
  geom_text(
    data = ticks,
    aes(x = t, y = 0.58, label = paste('(', 40+t, ')')),
    size = 3.5,
    color = dark
  ) +
  
  
  # montants au-dessus des paiements
  geom_text(
    data = cf,
    aes(x = t, y = -0.62, label = "$1000"),
    size = 4,
    color = blue
  ) +

  # segments verticaux
  geom_segment(
    data = segs_v,
    aes(x = x, xend = xend, y = y, yend = yend),
    linewidth = 0.9,
    color = blue
  ) +

  # segments horizontaux
  geom_segment(
    data = segs_h,
    aes(x = x, xend = xend, y = y, yend = yend),
    linewidth = 0.9,
    color = blue
  ) +

  # formules à gauche
  geom_text(
    data = eq,
    aes(x = x_left, y = y, label = frac_label),
    parse = TRUE,
    hjust = 0,
    size = 3.5,
    color = blue
  ) +

  # signe égal
  geom_text(
    data = eq,
    aes(x = -0.62, y = y, label = "="),
    size = 5,
    color = blue
  ) +

  # valeurs actualisées
  geom_text(
    data = eq,
    aes(x = x_val, y = y, label = pv_label),
    hjust = 0,
    size = 4,
    color = blue
  ) +

  # petite flèche gauche
  geom_text(
    data = eq,
    aes(x = x_arrow, y = y, label = "\u2190"),
    size = 5.5,
    color = blue
  ) +

  # trait de somme
  geom_segment(
    aes(x = -1.30, xend = -0.28, y = -5.92, yend = -5.92),
    linewidth = 1.0,
    color = blue
  ) +

  # plus
  geom_text(
    aes(x = -1.25, y = -5.72, label = "+"),
    size = 5.5,
    color = blue
  ) +

  # somme finale
  geom_text(
    aes(x = -1.10, y = -6.28, label = sum_pv),
    hjust = 0,
    size = 4,
    color = orange,
    fontface = "bold"
  ) +

  # texte final
  geom_text(
    aes(x = -0.02, y = -6.28, label = "Present Value of\nan Annuity Due"),
    hjust = 0,
    size = 4,
    color = orange,
    fontface = "bold"
  )


```
