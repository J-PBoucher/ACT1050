  x = 3.8,
  y = 0
)

p <- ggplot() +
  theme_void() +
  coord_cartesian(
  xlim = c(-1.4, t_max + 0.6),
  ylim = c(-2.2, 2.2),
  clip = "off") +

  # ligne du temps
  geom_segment(
    aes(x = 0, xend = t_max, y = 0, yend = 0),
    linewidth = 1.4,
    color = "#4a4a4a"
  ) +

  # graduations
  geom_segment(
    data = ticks,
    aes(x = t, xend = t, y = -0.10, yend = 0.10),
    linewidth = 1.2,
    color = "#4a4a4a"
  ) +

  # labels temps
  
  annotate(
  "text",
  x = -0.75,
  y =  0.35,
  label = "Temps (t)",
  parse = TRUE,
  size = 5
  ) +
  
  geom_text(
    data = ticks,
    aes(x = t, y = 0.35, label = t),
    size = 5,
    color = "#4a4a4a"
  ) +

  # labels des flux
  geom_text(
    data = cashflows,
    aes(x = t, y = -0.5, label = label),
    size = 5,
    color = "red"
  ) +

  # décès (croix rouge)
  geom_point(
    data = death,
    aes(x = x, y = y),
    shape = 4,
    size = 3,
    stroke = 1.5,
    color = "red"
  ) +
  
 geom_curve(
  aes(x = 3.05, y = 0.6, xend = 3.8, yend = 0.6),
  curvature = -0.25,
  color = "red",
  linewidth = 1.1,
  arrow = arrow(length = unit(0.18, "cm"))
  ) +
  
 annotate(
  "text",
  x = 3.4,      # milieu approximatif de la courbe
  y = 1.2,      # au-dessus de la courbe
  label = "q[x+3]",
  parse = TRUE,
  color = "red",
  size = 5) +
  
 geom_curve(
  aes(x = 0, y = 0.6, xend = 2.95, yend = 0.6),
