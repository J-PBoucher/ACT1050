  ) +
  annotate(
  "text",
  x = -0.75,
  y = -1.2,
  label = "2 %*% phantom(0)[1] * p[x] * q[x+1]",
  parse = TRUE,
  size = 5
)+
  annotate(
  "text",
  x = -0.75,
  y = -1.5,
  label = "3 %*% phantom(0)[2] * p[x] * q[x+2]",
  parse = TRUE,
  color="red",
  size = 5
)



